@echo off
chcp 65001 >nul
cd /d "%~dp0"

:: === Создание ярлыка на рабочем столе (только если его нет) ===
set "shortcut=%USERPROFILE%\Desktop\Create Test DB.lnk"
if not exist "%shortcut%" (
    powershell -command "$ws = New-Object -ComObject WScript.Shell; $s = $ws.CreateShortcut('%USERPROFILE%\Desktop\Create Test DB.lnk'); $s.TargetPath = '%~dp0create_test_db.bat'; $s.IconLocation = '%~dp0dashboard/ctdb_icon.ico, 0'; $s.Save()"
)

:: =============================================
:: ЗАПРОС ПАРАМЕТРОВ У ПОЛЬЗОВАТЕЛЯ
:: =============================================
echo ==========================================================
echo   Генерация тестовой базы данных
echo ==========================================================
echo.
echo Введите параметры (или нажмите Enter для значений по умолчанию):
echo.

set /p n_customers="Количество клиентов (по умолчанию 1000): "
if "%n_customers%"=="" set n_customers=1000

set /p n_transactions="Количество транзакций (по умолчанию 100000): "
if "%n_transactions%"=="" set n_transactions=100000

set /p start_date="Начальная дата (ГГГГ-ММ-ДД, по умолчанию 2020-01-01): "
if "%start_date%"=="" set start_date=2020-01-01

set /p end_date="Конечная дата (ГГГГ-ММ-ДД, по умолчанию 2026-12-31): "
if "%end_date%"=="" set end_date=2026-12-31

echo.
echo ==========================================================
echo   Параметры генерации:
echo   Клиентов: %n_customers%
echo   Транзакций: %n_transactions%
echo   Период: %start_date% - %end_date%
echo ==========================================================
echo.
echo Запуск генерации... Это может занять несколько минут...
echo.

:: =============================================
:: ПРОВЕРКА ВИРТУАЛЬНОГО ОКРУЖЕНИЯ
:: =============================================
if not exist "venv\" (
    echo Создание виртуального окружения...
    python -m venv venv
    echo Виртуальное окружение создано
)

call venv\Scripts\activate

:: =============================================
:: ЗАПУСК СКРИПТА С ПЕРЕДАЧЕЙ ПАРАМЕТРОВ
:: =============================================
python src\create_test_db.py %n_customers% %n_transactions% %start_date% %end_date%

:: =============================================
:: ПРОВЕРКА РЕЗУЛЬТАТА
:: =============================================
if exist "test_data\test_db.db" (
    echo.
    echo ==========================================================
    echo   Тестовая база данных успешно создана!
    echo   Путь: test_data\test_db.db
    echo   Размер:
    dir "test_data\test_db.db" | find "test_db.db"
    echo ==========================================================
    echo.
    echo Теперь вы можете загрузить этот файл в сервис:
    echo 1. Запустите CashFlow Forecaster
    echo 2. В боковой панели нажмите «Загрузка своей БД»
    echo 3. Выберите файл test_data\test_db.db
    echo 4. Поставьте галочку «Использовать загруженную БД»
    echo 5. Нажмите «Запустить прогноз»
) else (
    echo.
    echo ==========================================================
    echo   Ошибка: тестовая база данных НЕ создана.
    echo   Проверьте, что файл src\create_test_db.py существует.
    echo   и что у вас установлены все зависимости.
    echo ==========================================================
)

echo.
echo Нажмите любую клавишу для выхода...
pause >nul